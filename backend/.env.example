# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real credentials.

# Neon (or any Postgres) connection string.
# Neon console -> your project -> Connection string.
# IMPORTANT: SQLAlchemy needs the "postgresql://" scheme (not "postgres://").
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Allowed browser origins for CORS. Comma-separated for multiple
# (e.g. http://localhost:5173,https://signalscout.vercel.app).
FRONTEND_URL=http://localhost:5173

# Enable the Flask reloader/debugger locally. Leave unset or 0 in production:
# the Werkzeug debugger allows arbitrary code execution if publicly reachable.
FLASK_DEBUG=1

# Secret used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Must be set; the app refuses to start without it.
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_HEX_STRING

# JWT lifetime in hours (optional, defaults to 24).
JWT_EXP_HOURS=24
